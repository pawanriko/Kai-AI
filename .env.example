# Copy this file to ".env" and fill in your own keys.
# .env itself is gitignored — keys never enter the repo or the browser.
# Fill in as many providers as you like; the app uses whichever exist,
# and the model picker disables providers without a key.
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Optional: pin one provider (groq / openrouter / nvidia / deepseek /
# gemini) and disable cross-provider fallback.
# AI_PROVIDER=
# Optional: folder the coding agent may read/write/run code in.
# Defaults to <project>/agent_workspace. The agent can NEVER touch
# anything outside this folder.
# KAI_WORKSPACE=
